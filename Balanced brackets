def Balanced(s):
    stack = []
    bracket = {')': '(', '}': '{', ']': '['}
    for char in s:
        if char in bracket:
            top_element = stack.pop() if stack else '#'
            if bracket[char] != top_element:
                return "NO"
        else:
            stack.append(char)
    return "YES" if not stack else "NO"

if __name__ == "__main__":
    t = int(input())
    for _ in range(t):
        s = input()
        print(Balanced(s))
